{
  "name": "mixr",
  "private": true,
  "version": "0.2.0",
  "description": "Build a real, crossfaded DJ mix from songs you name, upload, or link",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "autopush": "node scripts/autoPush.mjs",
    "autopush:dry-run": "node scripts/autoPush.mjs --dry-run --once",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && MIXR_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:web": "concurrently -k -n vite,api -c cyan,green \"npm:dev:vite\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/standalone.ts",
    "web": "npm run build:client && tsx server/standalone.ts",
    "start:web": "tsx server/standalone.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:electron",
    "build:client": "vite build",
    "build:electron": "node scripts/buildElectron.mjs",
    "build:icon": "node scripts/makeIcon.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "doctor": "tsx scripts/doctor.ts",
    "check:search": "tsx scripts/checkSearch.ts",
    "check:ingest": "tsx scripts/checkIngest.ts",
    "check:analysis": "tsx scripts/checkAnalysis.ts",
    "check:beatmatch": "tsx scripts/checkBeatMatch.ts",
    "check:render": "tsx scripts/checkRender.ts",
    "check:api": "node scripts/checkApi.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac dir",
    "dist:pkg": "npm run build && electron-builder --mac pkg --x64"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "spotify-url-info": "^3.2.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "32.3.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.mixr.app",
    "productName": "mixR",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/ffmpeg-static/ffmpeg.br"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": null,
      "minimumSystemVersion": "10.15.0",
      "extendInfo": {
        "LSMinimumSystemVersion": "10.15.0",
        "NSMicrophoneUsageDescription": "mixR does not record audio."
      }
    },
    "dmg": {
      "title": "mixR ${version}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "allowAnywhere": true,
      "allowCurrentUserHome": true
    }
  }
}
